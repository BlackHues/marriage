# Protect SQLite database files and sensitive configs from direct web access
<FilesMatch "\.(sqlite|db|log|ini|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

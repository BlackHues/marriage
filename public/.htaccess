<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route API requests to the PHP backend script
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api/?$ api/index.php [QSA,L]

  # 2. Serve static files directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all other requests to React Single Page App index.html
  RewriteRule ^ index.html [L]
</IfModule>

# MIME type headers for MP3 and fonts
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType image/svg+xml .svg
</IfModule>

# Enable GZIP Compression for fast loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
